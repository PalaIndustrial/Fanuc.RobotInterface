<UserControl x:Class="FANUCRobotTest.UI.RobotIndexDataDisplayControl"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:FANUCRobotTest" xmlns:local_ui="clr-namespace:FANUCRobotTest.UI" mc:Ignorable="d"
        d:DesignHeight="450" d:DesignWidth="800">

    <HeaderedContentControl>
        <HeaderedContentControl.Header>
            <Grid Margin="2" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="TitleLabel" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Margin="8,2" VerticalAlignment="Center" d:Text="SDI:">
                    <Run
                            Text="{Binding SignalName, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local_ui:RobotIndexDataDisplayControl}}}" />:
                </TextBlock>
                <ui:TextBox Grid.Column="1" Margin="2" MinWidth="160" VerticalContentAlignment="Center"
                        PlaceholderText="Index"
                        Text="{Binding SelectedSignalIndex, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local_ui:RobotIndexDataDisplayControl}}}" />
                <Button Grid.Column="2" Margin="2" VerticalAlignment="Center" Click="Button_Add_Click">
                    <ui:SymbolIcon Symbol="Add16" />
                </Button>
            </Grid>
        </HeaderedContentControl.Header>
        <ItemsControl Grid.IsSharedSizeScope="True"
                ItemsPanel="{Binding SignalItemsPanel, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local_ui:RobotIndexDataDisplayControl}}}"
                ItemTemplate="{Binding SignalItemTemplate, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local_ui:RobotIndexDataDisplayControl}}}"
                ItemTemplateSelector="{Binding SignalItemTemplateSelector, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local_ui:RobotIndexDataDisplayControl}}}"
                ItemsSource="{Binding SignalItemsSource, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type local_ui:RobotIndexDataDisplayControl}}}">
        </ItemsControl>
    </HeaderedContentControl>

</UserControl>
